# Copy to .env in the repo root (or export in your shell).
# API loads these from the process environment.

# Postgres — docker-compose default, or a Supabase connection string
DATABASE_URL=postgres://localdiscovery:localdiscovery@localhost:5432/localdiscovery?sslmode=disable

# App JWT (httpOnly cookie). Change in anything beyond local demo.
JWT_SECRET=dev-jwt-secret-change-me-please-32chars

# HTTP
API_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:5173
COOKIE_SECURE=false

# Optional OpenID Connect (authorization code + PKCE).
# If unset, password login still works; "Continue with OpenID" returns a clear error.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8080/auth/oidc/callback
OIDC_LABEL=Continue with OpenID

# Optional LLM for the catalog chatbot. Without this, FAQ/template answers are used.
OPENAI_API_KEY=

# Local disk photos
BLOB_DIR=./data/blobs

# Vite
VITE_API_URL=http://localhost:8080
